# Recognition filter — set ONE of these. Without a key, ingest runs normally
# and images queue with status UNSCORED.

# OpenRouter (OpenAI-compatible endpoint)
OPENROUTER_API_KEY=

# …or the Anthropic API directly
# ANTHROPIC_API_KEY=

# Model overrides. Defaults differ per provider; pin exact slugs here.
# OpenRouter defaults:  anthropic/claude-haiku-4.5  /  anthropic/claude-sonnet-5
#   verified against openrouter /api/v1/models on 2026-07-26:
#     haiku-4.5   $1/M in   $5/M out
#     sonnet-5    $2/M in   $10/M out
#   sonnet-5 is newer AND cheaper than sonnet-4.5 ($3/$15) — don't downgrade.
# Anthropic defaults:   claude-haiku-4-5-20251001   /  claude-sonnet-5
# JM_TRIAGE_MODEL=
# JM_ID_MODEL=

# Cost ceilings. Measured supply is ~5-9 genuinely new images/day, so the daily
# cap is ~30x headroom. Scored images are cached to disk and never re-charged,
# including across restarts.
# JM_MAX_IMAGES=12
# JM_MAX_IMAGES_PER_DAY=250

PORT=8140
# JM_DATA_DIR=./data
# JM_VERBOSE=1
